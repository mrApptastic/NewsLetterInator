@page "/mail"

@inject GmailService GmailSender
@inject GoogleSheetsService GoogleSheetsService
@inject IGoogleDriveService GoogleDriveService
@inject AppState AppState
@implements IDisposable

<PageTitle>Mail</PageTitle>

<h1>Mail</h1>

@if (AppState.SelectedSheet is null)
{
    <p>Select a sheet first on the Sheets page.</p>
}
else
{
    <p class="text-muted">Sheet: <strong>@AppState.SelectedSheet.Name</strong></p>
    <p>Selected recipients: <strong>@AppState.SelectedPeople.Count</strong></p>

    @if (AppState.SelectedPeople.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Recipients</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var recipient in AppState.SelectedPeople)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@recipient.Name</span>
                            <small class="text-muted">@recipient.Email</small>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <p>Go to People and select at least one active recipient.</p>
    }

    @if (ShowComposeSection)
    {
        <div class="card p-3 mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="templateSelect">Template</label>
                    <select id="templateSelect" class="form-select" @bind="selectedTemplateName">
                        <option value="">Choose template...</option>
                        @foreach (var template in templates)
                        {
                            <option value="@template.Name">@template.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-secondary w-100" @onclick="LoadTemplateAsync" disabled="@isSending">Load template</button>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="templateName">Save as template name</label>
                    <input id="templateName" class="form-control" @bind="templateName" />
                </div>
            </div>

            <div class="mt-2">
                <button class="btn btn-outline-primary" @onclick="SaveTemplateAsync" disabled="@isSending">Save template</button>
            </div>
        </div>

        <div class="mb-3">
            <label for="subject" class="form-label">Subject</label>
            <input id="subject" class="form-control" @bind="subject" />
        </div>

        <div class="alert alert-info py-2">
            Available merge fields: <code>{Name}</code>, <code>{Email}</code>, <code>{CustomField_1}</code>, <code>{CustomField_2}</code>, <code>{CustomField_3}</code>, <code>{CustomField_4}</code>, <code>{CustomField_5}</code>, <code>{CustomField_6}</code>, <code>{CustomField_7}</code>, <code>{CustomField_8}</code>, <code>{CustomField_9}</code>, <code>{CustomField_10}</code>
        </div>

        <div class="form-check mb-3">
            <input id="isHtml" class="form-check-input" type="checkbox" @bind="isHtml" />
            <label for="isHtml" class="form-check-label">Send as HTML</label>
        </div>

        <div class="mb-3">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" class="form-control" rows="7" @bind="message"></textarea>
        </div>

        <div class="mb-3">
            <label for="attachments" class="form-label">Attachments</label>
            <InputFile id="attachments" class="form-control" OnChange="HandleAttachmentsSelected" multiple />
            <div class="form-text">When you save a template, selected attachments are uploaded to Drive and linked to the template for reuse.</div>
        </div>
    }

    @if (WizardMode && !PreviewMode)
    {
        <div class="alert alert-secondary mb-3">Use the Next button to continue to preview and send.</div>
    }

    @if (ShowPreviewAndSendSection && AppState.SelectedPeople.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Preview</h5>
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="previewRecipient">Preview recipient</label>
                        <select id="previewRecipient" class="form-select" @bind="selectedPreviewRecipientEmail">
                            @foreach (var recipient in AppState.SelectedPeople)
                            {
                                <option value="@recipient.Email">@recipient.Name (@recipient.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <span class="text-muted">Type: @(isHtml ? "HTML" : "Plain text")</span>
                    </div>
                </div>

                <div class="mb-2"><strong>Subject preview</strong></div>
                <div class="border rounded p-2 mb-3">@GetPreviewSubject()</div>

                <div class="mb-2"><strong>Body preview</strong></div>
                @if (isHtml)
                {
                    <div class="border rounded p-3 bg-white">@((MarkupString)GetPreviewBody())</div>
                }
                else
                {
                    <pre class="border rounded p-3 bg-light mb-0" style="white-space: pre-wrap;">@GetPreviewBody()</pre>
                }
            </div>
        </div>
    }

    @if (attachments.Count > 0)
    {
        <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <strong>Selected files</strong>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAttachments" disabled="@isSending">Clear</button>
            </div>

            <ul class="list-group">
                @foreach (var attachment in attachments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@attachment.FileName</span>
                        <small class="text-muted">@GetAttachmentInfo(attachment)</small>
                    </li>
                }
            </ul>
        </div>
    }

    @if (ShowPreviewAndSendSection)
    {
        <button class="btn btn-primary" @onclick="SendAsync" disabled="@(isSending || AppState.SelectedPeople.Count == 0)">Send</button>
    }

    @if (ShowPreviewAndSendSection && isSending)
    {
        <div class="alert alert-warning mt-3">
            Sending mail@(string.IsNullOrWhiteSpace(currentRecipientEmail) ? string.Empty : $" to {currentRecipientEmail}")...
        </div>
    }

    @if (ShowPreviewAndSendSection && sentRecipients.Count > 0)
    {
        <div class="mt-3">
            <strong>Sent:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var sentRecipient in sentRecipients)
                {
                    <li>@sentRecipient</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success mt-3">@successMessage</div>
    }
}

@code {
    [Parameter] public bool WizardMode { get; set; }
    [Parameter] public bool PreviewMode { get; set; }

    private string subject = "Test mail";
    private string message = "Hej {Name},\n\nDette er en testmail fra vores POC.";
    private bool isHtml;
    private bool isSending;
    private string? currentRecipientEmail;
    private string? errorMessage;
    private string? successMessage;
    private string templateName = "Default";
    private string selectedTemplateName = string.Empty;
    private readonly List<MailTemplate> templates = [];
    private readonly List<MailAttachment> attachments = [];
    private readonly List<string> sentRecipients = [];
    private string selectedPreviewRecipientEmail = string.Empty;
    private const long MaxAttachmentSize = 10 * 1024 * 1024;
    private static readonly TimeSpan SendDelay = TimeSpan.FromSeconds(1);
    private bool ShowComposeSection => !WizardMode || !PreviewMode;
    private bool ShowPreviewAndSendSection => !WizardMode || PreviewMode;

    protected override async Task OnInitializedAsync()
    {
        AppState.Changed += OnAppStateChanged;
        await LoadTemplatesForCurrentSheetAsync();
    }

    public void Dispose()
    {
        AppState.Changed -= OnAppStateChanged;
    }

    private void OnAppStateChanged()
    {
        EnsurePreviewRecipient();
        _ = InvokeAsync(LoadTemplatesForCurrentSheetAsync);
    }

    private async Task LoadTemplatesForCurrentSheetAsync()
    {
        if (AppState.SelectedSheet is null)
        {
            templates.Clear();
            selectedTemplateName = string.Empty;
            return;
        }

        try
        {
            templates.Clear();
            templates.AddRange(await GoogleSheetsService.GetMailTemplatesAsync(AppState.SelectedSheet.Id));

            if (!templates.Any(x => string.Equals(x.Name, selectedTemplateName, StringComparison.OrdinalIgnoreCase)))
            {
                selectedTemplateName = string.Empty;
            }

            EnsurePreviewRecipient();
        }
        catch
        {
            // Do not block the mail UI if template loading fails.
        }
    }

    private async Task SaveTemplateAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (AppState.SelectedSheet is null)
        {
            errorMessage = "Select a sheet first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(templateName))
        {
            errorMessage = "Template name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(message))
        {
            errorMessage = "Subject and message are required.";
            return;
        }

        isSending = true;
        try
        {
            var templateAttachments = new List<MailAttachment>();
            foreach (var attachment in attachments)
            {
                if (attachment.IsStoredOnDrive && !string.IsNullOrWhiteSpace(attachment.DriveFileId))
                {
                    templateAttachments.Add(attachment);
                    continue;
                }

                var uploaded = await GoogleDriveService.UploadTemplateAttachmentAsync(AppState.SelectedSheet.Id, templateName, attachment);
                templateAttachments.Add(uploaded);
            }

            await GoogleSheetsService.SaveMailTemplateAsync(AppState.SelectedSheet.Id, new MailTemplate
            {
                Name = templateName,
                Subject = subject,
                Body = message,
                IsHtml = isHtml,
                AttachmentFileIds = templateAttachments
                    .Select(x => x.DriveFileId)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Select(x => x!)
                    .Distinct(StringComparer.Ordinal)
                    .ToList()
            });

            attachments.Clear();
            attachments.AddRange(templateAttachments);

            await LoadTemplatesForCurrentSheetAsync();
            selectedTemplateName = templateName;
            successMessage = $"Template '{templateName}' saved.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task LoadTemplateAsync()
    {
        errorMessage = null;
        successMessage = null;

        var selected = templates.FirstOrDefault(x => string.Equals(x.Name, selectedTemplateName, StringComparison.OrdinalIgnoreCase));
        if (selected is null)
        {
            errorMessage = "Select a template to load.";
            return;
        }

        templateName = selected.Name;
        subject = selected.Subject;
        message = selected.Body;
        isHtml = selected.IsHtml;

        attachments.Clear();
        foreach (var fileId in selected.AttachmentFileIds.Distinct(StringComparer.Ordinal))
        {
            try
            {
                attachments.Add(await GoogleDriveService.GetAttachmentAsync(fileId, includeContent: false));
            }
            catch
            {
                // Ignore missing/inaccessible attachments and keep loading the rest of the template.
            }
        }

        EnsurePreviewRecipient();
        successMessage = $"Template '{selected.Name}' loaded.";
    }

    private async Task HandleAttachmentsSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        successMessage = null;
        attachments.Clear();

        try
        {
            foreach (var file in e.GetMultipleFiles())
            {
                if (file.Size > MaxAttachmentSize)
                {
                    errorMessage = $"File '{file.Name}' is too large. Maximum size per attachment is {FormatFileSize(MaxAttachmentSize)}.";
                    continue;
                }

                await using var stream = file.OpenReadStream(MaxAttachmentSize);
                await using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);

                attachments.Add(new MailAttachment
                {
                    FileName = file.Name,
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    Size = file.Size,
                    IsStoredOnDrive = false,
                    Content = memoryStream.ToArray()
                });
            }
        }
        catch (Exception ex)
        {
            attachments.Clear();
            errorMessage = ex.Message;
        }
    }

    private void ClearAttachments()
    {
        attachments.Clear();
        errorMessage = null;
        successMessage = null;
    }

    private async Task SendAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(message))
        {
            errorMessage = "Subject and message are required.";
            return;
        }

        var recipients = AppState.SelectedPeople.ToList();
        if (recipients.Count == 0)
        {
            errorMessage = "No active recipients selected.";
            return;
        }

        isSending = true;
        sentRecipients.Clear();
        currentRecipientEmail = null;

        try
        {
            var attachmentsToSend = await ResolveAttachmentsForSendingAsync();

            for (var index = 0; index < recipients.Count; index++)
            {
                var person = recipients[index];
                currentRecipientEmail = person.Email;
                StateHasChanged();

                await GmailSender.SendEmailAsync(person, subject, message, isHtml, attachmentsToSend);
                sentRecipients.Add($"{person.Name} <{person.Email}>");
                StateHasChanged();

                if (index < recipients.Count - 1)
                {
                    await Task.Delay(SendDelay);
                }
            }

            successMessage = $"Sent {recipients.Count} message(s).";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSending = false;
            currentRecipientEmail = null;
            StateHasChanged();
        }
    }

    private async Task<List<MailAttachment>> ResolveAttachmentsForSendingAsync()
    {
        var resolved = new List<MailAttachment>(attachments.Count);

        foreach (var attachment in attachments)
        {
            if (attachment.IsStoredOnDrive && !string.IsNullOrWhiteSpace(attachment.DriveFileId))
            {
                resolved.Add(await GoogleDriveService.GetAttachmentAsync(attachment.DriveFileId, includeContent: true));
                continue;
            }

            resolved.Add(attachment);
        }

        return resolved;
    }

    private string GetAttachmentInfo(MailAttachment attachment)
    {
        var source = attachment.IsStoredOnDrive ? "Drive" : "Local";
        return $"{source} - {FormatFileSize(attachment.Size)}";
    }

    private Person? GetPreviewRecipient()
    {
        EnsurePreviewRecipient();
        if (string.IsNullOrWhiteSpace(selectedPreviewRecipientEmail))
        {
            return null;
        }

        return AppState.SelectedPeople.FirstOrDefault(person =>
            string.Equals(person.Email, selectedPreviewRecipientEmail, StringComparison.OrdinalIgnoreCase));
    }

    private string GetPreviewSubject()
    {
        var recipient = GetPreviewRecipient();
        return recipient is null ? subject : GmailService.RenderTemplate(subject, recipient);
    }

    private string GetPreviewBody()
    {
        var recipient = GetPreviewRecipient();
        return recipient is null ? message : GmailService.RenderTemplate(message, recipient);
    }

    private void EnsurePreviewRecipient()
    {
        if (AppState.SelectedPeople.Count == 0)
        {
            selectedPreviewRecipientEmail = string.Empty;
            return;
        }

        if (!AppState.SelectedPeople.Any(person =>
                string.Equals(person.Email, selectedPreviewRecipientEmail, StringComparison.OrdinalIgnoreCase)))
        {
            selectedPreviewRecipientEmail = AppState.SelectedPeople[0].Email;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes / (1024d * 1024d):0.#} MB";
    }
}

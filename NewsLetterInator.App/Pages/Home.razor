@page "/"
@inject IGoogleAuthService GoogleAuthService
@inject AppState AppState
@implements IDisposable

<PageTitle>Newsletter Wizard</PageTitle>

<h1>Newsletter Wizard</h1>

<ol class="list-group list-group-numbered mb-4">
    <li class="list-group-item @(AppState.IsSignedIn ? "list-group-item-success" : "list-group-item-warning")">
        Login
    </li>
    <li class="list-group-item @(AppState.SelectedSheet is null ? string.Empty : "list-group-item-success")">
        Select or create a sheet
    </li>
    <li class="list-group-item @(AppState.SelectedPeople.Count == 0 ? string.Empty : "list-group-item-success")">
        Select recipients
    </li>
    <li class="list-group-item @(activeStep > WizardStep.ComposeMail ? "list-group-item-success" : string.Empty)">
        Create the mail
    </li>
    <li class="list-group-item @(activeStep == WizardStep.PreviewAndSend ? "list-group-item-primary" : string.Empty)">
        Preview and send
    </li>
</ol>

@if (!AppState.IsSignedIn)
{
    <div class="card p-4">
        <h2 class="h4">Sign in to continue</h2>
        <p class="text-muted mb-3">Use your Google account to access Sheets, Drive and Gmail.</p>
        <button class="btn btn-primary" @onclick="SignInAsync" disabled="@isSigningIn">Sign in with Google</button>
    </div>
}
else
{
    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-outline-secondary" @onclick="MovePrevious" disabled="@(activeStep == WizardStep.Sheet)">Back</button>
        <button class="btn btn-primary" @onclick="MoveNext" disabled="@(!CanMoveNext())">Next</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (activeStep == WizardStep.Sheet)
    {
        <Sheets />
    }
    else if (activeStep == WizardStep.Recipients)
    {
        <People />
    }
    else
    {
        <Mail WizardMode="true" PreviewMode="@(activeStep == WizardStep.PreviewAndSend)" />
    }
}

@code {
    private WizardStep activeStep = WizardStep.Sheet;
    private bool isSigningIn;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        AppState.Changed += OnAppStateChanged;
        activeStep = GetHighestAvailableStep();
    }

    public void Dispose()
    {
        AppState.Changed -= OnAppStateChanged;
    }

    private async Task SignInAsync()
    {
        isSigningIn = true;
        errorMessage = null;

        try
        {
            await GoogleAuthService.RequestAccessTokenAsync();
            AppState.SetSignedInUser(await GoogleAuthService.GetCurrentUserAsync());
            activeStep = GetHighestAvailableStep();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSigningIn = false;
        }
    }

    private void OnAppStateChanged()
    {
        if (!AppState.IsSignedIn)
        {
            activeStep = WizardStep.Sheet;
            errorMessage = null;
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        var highestAvailableStep = GetHighestAvailableStep();
        if (activeStep > highestAvailableStep)
        {
            activeStep = highestAvailableStep;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void MovePrevious()
    {
        if (activeStep > WizardStep.Sheet)
        {
            activeStep--;
        }
    }

    private void MoveNext()
    {
        if (!CanMoveNext())
        {
            return;
        }

        activeStep++;
    }

    private bool CanMoveNext()
    {
        return activeStep < GetHighestAvailableStep();
    }

    private WizardStep GetHighestAvailableStep()
    {
        if (!AppState.IsSignedIn || AppState.SelectedSheet is null)
        {
            return WizardStep.Sheet;
        }

        if (AppState.SelectedPeople.Count == 0)
        {
            return WizardStep.Recipients;
        }

        return WizardStep.PreviewAndSend;
    }

    private enum WizardStep
    {
        Sheet = 0,
        Recipients = 1,
        ComposeMail = 2,
        PreviewAndSend = 3
    }
}

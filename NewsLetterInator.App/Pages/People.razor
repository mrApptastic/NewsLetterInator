@page "/people"
@inject GoogleSheetsService GoogleSheetsService
@inject AppState AppState

<PageTitle>People</PageTitle>

<h1>People</h1>

@if (AppState.SelectedSheet is null)
{
    <p>Select a sheet on the Sheets page first.</p>
}
else
{
    <p class="text-muted">Sheet: <strong>@AppState.SelectedSheet.Name</strong></p>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="LoadPeopleAsync" disabled="@isLoading">Refresh People</button>
        <span class="ms-1">
            <label class="form-check-label">
                <input type="checkbox" class="form-check-input" checked="@checkAll" @onchange="ToggleSelectAll" />
                Select All
            </label>
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (people.Count == 0)
    {
        <p>No people found.</p>
    }
    else
    {
        <ul class="list-group mb-4">
            @foreach (var person in people)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <label class="d-flex align-items-center gap-2 w-100" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input" checked="@AppState.IsPersonSelected(person.Email)"
                               @onchange="args => ToggleSelection(person, args)" />
                        <span>@(person.Active ? "☑" : "☐") @person.Name</span>
                        <span class="text-muted">@person.Email</span>
                    </label>
                </li>
            }
        </ul>
    }

    <h2>Add person</h2>
    <div class="row g-2">
        <div class="col-12 col-md-4">
            <input class="form-control" @bind="newPerson.Name" placeholder="Name" />
        </div>
        <div class="col-12 col-md-4">
            <input class="form-control" @bind="newPerson.Email" placeholder="Email" />
        </div>
        <div class="col-12 col-md-2 d-flex align-items-center">
            <label class="form-check-label">
                <input type="checkbox" class="form-check-input" @bind="newPerson.Active" /> Active
            </label>
        </div>
        <div class="col-12 col-md-4">
            <input class="form-control" @bind="newPerson.CustomField_1" placeholder="Custom field 1" />
        </div>
        <div class="col-12 col-md-4">
            <input class="form-control" @bind="newPerson.CustomField_2" placeholder="Custom field 2" />
        </div>
        <div class="col-12 col-md-4">
            <input class="form-control" @bind="newPerson.CustomField_3" placeholder="Custom field 3" />
        </div>
        <div class="col-12 col-md-4">
            <input class="form-control" @bind="newPerson.CustomField_4" placeholder="Custom field 4" />
        </div>
        <div class="col-12 col-md-4">
            <input class="form-control" @bind="newPerson.CustomField_5" placeholder="Custom field 5" />
        </div>
        <div class="col-12 col-md-4 d-flex align-items-end">
            <button class="btn btn-secondary w-100" @onclick="AddPersonAsync" disabled="@isLoading">Add person</button>
        </div>
    </div>
}

@code {
    private readonly List<Person> people = [];
    private Person newPerson = new();
    private bool isLoading;
    private bool checkAll = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPeopleAsync();
    }

    private async Task LoadPeopleAsync()
    {
        if (AppState.SelectedSheet is null)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            people.Clear();
            people.AddRange(await GoogleSheetsService.GetPeopleAsync(AppState.SelectedSheet.Id));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddPersonAsync()
    {
        if (AppState.SelectedSheet is null)
        {
            errorMessage = "No sheet selected.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPerson.Name) || string.IsNullOrWhiteSpace(newPerson.Email))
        {
            errorMessage = "Name and email are required.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await GoogleSheetsService.AddPersonAsync(AppState.SelectedSheet.Id, newPerson);
            successMessage = $"Added {newPerson.Name}.";
            newPerson = new Person { Active = true };
            await LoadPeopleAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSelection(Person person, ChangeEventArgs args)
    {
        var isSelected = args.Value is bool b && b;
        AppState.SetPersonSelected(person, isSelected);
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        checkAll = args.Value is bool b && b;
        foreach (var person in people)
        {
            AppState.SetPersonSelected(person, checkAll);
        }
    }
}

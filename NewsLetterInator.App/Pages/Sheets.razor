@page "/sheets"
@inject GoogleSheetsService GoogleSheetsService
@inject AppState AppState

<PageTitle>Sheets</PageTitle>

<h1>My Sheets</h1>

<div class="mb-3 d-flex gap-2">
    <button class="btn btn-primary" @onclick="RefreshAsync" disabled="@isLoading">Refresh</button>
    <button class="btn btn-secondary" @onclick="CreateSheetAsync" disabled="@isLoading">Create New Sheet</button>
</div>

<div class="mb-3">
    <label class="form-label" for="sheetName">New sheet name</label>
    <input id="sheetName" class="form-control" @bind="newSheetName" placeholder="People Sheet" />
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (isLoading)
{
    <p><em>Loading sheets...</em></p>
}
else if (sheets.Count == 0)
{
    <p>No sheets found yet. Create one to get started.</p>
}
else
{
    <ul class="list-group">
        @foreach (var sheet in sheets)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@sheet.Name</strong>
                    <div class="text-muted small">@sheet.Id</div>
                </div>
                <button class="btn btn-outline-primary btn-sm" @onclick="() => SelectSheet(sheet)">
                    @(AppState.SelectedSheet?.Id == sheet.Id ? "Selected" : "Select")
                </button>
            </li>
        }
    </ul>
}

@code {
    private readonly List<SheetInfo> sheets = [];
    private bool isLoading;
    private string newSheetName = "People Sheet";
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            sheets.Clear();
            sheets.AddRange(await GoogleSheetsService.GetSheetsAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateSheetAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var created = await GoogleSheetsService.CreateSheetAsync(newSheetName);
            AppState.SetSelectedSheet(created);
            AppState.ClearSelectedPeople();
            successMessage = $"Created and selected sheet '{created.Name}'.";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectSheet(SheetInfo sheet)
    {
        AppState.SetSelectedSheet(sheet);
        AppState.ClearSelectedPeople();
        successMessage = $"Selected sheet '{sheet.Name}'.";
        errorMessage = null;
    }
}
